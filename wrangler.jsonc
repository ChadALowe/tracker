{
  // Change "name" to match your existing Worker if it's called something else,
  // otherwise deploying creates a second Worker.
  "name": "tracker",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  // Keep variables added in the dashboard when deploying from GitHub.
  "keep_vars": true,

  // The portal page. /api/* goes to the Worker code; everything else is a static file.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // Runs every minute. The Worker itself decides whether it's within tracking hours,
  // using UK time, so nothing here needs changing when the clocks go back or forward.
  "triggers": { "crons": ["* * * * *"] },

  // The "presence" D1 database. Tables are created automatically on first run.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "presence",
      "database_id": "89117845-a3b9-48fe-a745-e1ce40dad212"
    }
  ],

  // Secrets (set in the dashboard under Settings → Variables and Secrets, type "Secret"):
  //   AZURE_TENANT_ID, AZURE_CLIENT_ID, AZURE_CLIENT_SECRET, PORTAL_PASSWORD
  "observability": { "enabled": true }
}
